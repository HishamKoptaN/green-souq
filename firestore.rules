rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validOwnedFeedback() {
      return request.resource.data.keys().hasAll([
               'title',
               'description',
               'createdAt',
               'userId',
             ])
          && request.resource.data.keys().hasOnly([
               'title',
               'description',
               'createdAt',
               'userId',
             ])
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.createdAt is int
          && request.resource.data.userId is string
          && isOwner(request.resource.data.userId);
    }

    // The jobs screen is public and reads the whole collection without filters.
    // Jobs are managed from the backend, so clients are read-only here.
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow get, list: if isOwner(resource.data.userId);
      allow create: if validOwnedFeedback();
      allow update, delete: if false;
    }

    match /suggestions/{suggestionId} {
      allow get, list: if isOwner(resource.data.userId);
      allow create: if validOwnedFeedback();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
