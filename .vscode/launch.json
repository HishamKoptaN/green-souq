{
  "version": "0.3.0",
  "configurations": [
    {
      "name": "Web Dev 🌐",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=ENV=dev",
        "--web-browser-flag=--disable-features=PrivacySandboxAdsApis",
        "--web-browser-flag=--no-default-browser-check",
        "--web-browser-flag=--no-first-run"
      ],
      "deviceId": "chrome"
    },
    {
      "name": "Android Dev",
      "type": "dart",
      "debugExternalLibraries": false,
      "debugSdkLibraries": false,
      "request": "launch",
      "preLaunchTask": "run-adb-reverse",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "dev",
        "--dart-define=ENV=dev",
      ],
      "deviceId": "CPH2325",
      "attachToExistingApp": false,
      "showDebuggerOnStart": true
    },
  ]
}